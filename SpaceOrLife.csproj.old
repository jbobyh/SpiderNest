<Project Sdk="Godot.NET.Sdk/4.7.0-dev.5">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net8.0-android</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0-ios</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'web' ">net8.0-browser</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SpaceOrLife</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
